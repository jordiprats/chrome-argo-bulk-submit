{
  "manifest_version": 3,
  "name": "Argo Submit",
  "version": "0.1.0",
  "description": "Hands your Argo Workflows SSO session token to the argo CLI.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["cookies", "storage", "nativeMessaging", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Argo Submit", "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
